{
  "name": "venueloom",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @venueloom/web",
    "build": "npm run build --workspace @venueloom/web",
    "start": "npm run start --workspace @venueloom/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test packages/importer/test/*.test.ts packages/integrations/test/*.test.ts packages/database/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@netlify/functions": "6.0.0"
  }
}
