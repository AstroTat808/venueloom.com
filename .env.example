# VenueLoom runtime
NEXT_PUBLIC_APP_NAME=VenueLoom
VENUELOOM_PUBLIC_URL=https://venueloom.com

# Neon PostgreSQL
DATABASE_URL=
VENUELOOM_DB_POOL_MAX=4

# 32 random bytes, base64 encoded. Never reuse across unrelated environments.
VENUELOOM_SECRET_ENCRYPTION_KEY=

# First-owner bootstrap is an explicit temporary gate. Turn off after approved workspace creation.
VENUELOOM_ALLOW_OWNER_BOOTSTRAP=false

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Graph Calendar OAuth
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
