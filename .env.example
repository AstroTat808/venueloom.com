# VenueLoom runtime
PUBLIC_APP_URL=https://venueloom.com

# Restricted runtime Neon role. Must not own tables or BYPASSRLS.
DATABASE_URL=

# Privileged worker/migration URL. Functions/jobs only; never expose to browser code.
DATABASE_SERVICE_URL=

# base64-encoded 32-byte AES key used for OAuth tokens and private iCal source URLs.
VENUELOOM_ENCRYPTION_KEY=

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Graph Calendar OAuth
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
